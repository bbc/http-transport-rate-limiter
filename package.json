  "devDependencies": {
    "@bbc/http-transport": "^4.3.0",
    "eslint": "^4.18.2",
    "eslint-config-iplayer-es6": "^1.3.0",
    "jest": "^30.1.3",
    "simple-rate-limiter": "^0.2.3"
  },
  "eslintConfig": {
